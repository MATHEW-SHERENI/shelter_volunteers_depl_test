# Copy to .env.local for local development, or set these in the Vercel frontend project.
# This public OAuth client ID must match GOOGLE_CLIENT_ID on the Flask backend.
REACT_APP_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# On Vercel, set REACT_APP_SERVER_URL=/api to use the proxy in vercel.json.
# Leave it empty only locally to use the development proxy in package.json.
REACT_APP_SERVER_URL=
