{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "REACT_APP_SERVER_URL=/api npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shelter-volunteers-depl-test.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
